{
  "name": "georgia-portfolio",
  "version": "1.0.0",
  "description": "Premium portfolio για τη Γεωργία — Social Media Content Creator & Graphic Designer",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o css/tailwind.css --minify",
